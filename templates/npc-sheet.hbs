<form class="hf-root hf-npc {{state.classes}}" autocomplete="off">

  {{!-- Cinematic layers --}}
  <div class="hf-backdrop" style="--hf-backdrop-op: calc({{backdrop.opacity}} / 100);">
    {{#if backdrop.img}}
      {{#if backdrop.isVideo}}
        <video src="{{backdrop.img}}" autoplay loop muted playsinline></video>
      {{else}}
        <img src="{{backdrop.img}}" alt="">
      {{/if}}
    {{/if}}
  </div>
  <div class="hf-grain" aria-hidden="true"></div>
  <div class="hf-vignette" aria-hidden="true"></div>
  <div class="hf-flash" aria-hidden="true"></div>

  {{!-- ══════════ LEFT RAIL ══════════ --}}
  <aside class="hf-rail">
    <div class="hf-portrait-frame" data-action="portrait" title="{{localize 'HOPEFINDER.Header.ChangePortrait'}}">
      <span class="hf-corner tl"></span><span class="hf-corner tr"></span>
      <span class="hf-corner bl"></span><span class="hf-corner br"></span>
      {{#if header.portraitIsVideo}}
        <video class="hf-portrait" src="{{header.img}}" autoplay loop muted playsinline></video>
      {{else}}
        <img class="hf-portrait" src="{{header.img}}" alt="{{header.name}}">
      {{/if}}
      <div class="hf-portrait-blood" aria-hidden="true"></div>
      <div class="hf-portrait-scan" aria-hidden="true"></div>
      <div class="hf-id-strip">
        <span class="hf-id-level">LV {{header.level}}</span>
        <span class="hf-id-state hf-lamp--{{state.id}}">{{state.label}}</span>
      </div>
    </div>

    <div class="hf-identity">
      <h1 class="hf-name">{{header.name}}</h1>
      {{#if editable}}
        <input type="text" class="hf-callsign" name="system.details.blurb" value="{{header.blurb}}"
               placeholder="{{localize 'HOPEFINDER.Npc.Blurb'}}">
      {{else if header.blurb}}
        <div class="hf-callsign-static">{{header.blurb}}</div>
      {{/if}}
      <div class="hf-role-line">
        <span class="hf-role-pill hf-role-pill--{{header.rarity}}">{{header.rarityLabel}}</span>
        {{#each header.traits}}
          <span class="hf-role-pill">{{this}}</span>
        {{/each}}
      </div>
    </div>

    <nav class="hf-nav" role="tablist">
      {{#each tabs}}
        <button type="button" class="hf-nav-item {{#if this.active}}active{{/if}}" role="tab"
                data-action="tab" data-tab="{{this.id}}" aria-selected="{{this.active}}">
          <i class="fas {{this.icon}}"></i><span>{{this.label}}</span>
        </button>
      {{/each}}
    </nav>

    <div class="hf-rail-actions">
      <button type="button" data-action="roll-initiative" title="{{localize 'HOPEFINDER.Actions.Initiative'}}">
        <i class="fas fa-bolt"></i>
      </button>
      <button type="button" data-action="backdrop-config" title="{{localize 'HOPEFINDER.Backdrop.Title'}}">
        <i class="fas fa-panorama"></i>
      </button>
    </div>
  </aside>

  {{!-- ══════════ MAIN STAGE ══════════ --}}
  <main class="hf-stage">

    <header class="hf-statusbar">
      <div class="hf-hp-module" data-low="{{combat.hp.low}}">
        <div class="hf-hp-readout">
          <i class="fas fa-heart-pulse"></i>
          <span class="hf-hp-num">{{combat.hp.value}}</span>
          <span class="hf-hp-sep">/</span>
          <span class="hf-hp-max">{{combat.hp.max}}</span>
          {{#if combat.hp.temp}}<span class="hf-hp-temp">+{{combat.hp.temp}}</span>{{/if}}
        </div>
        <div class="hf-hp-track">
          <div class="hf-hp-fill" style="width: {{combat.hp.pct}}%;"></div>
          <div class="hf-hp-ticks" aria-hidden="true"></div>
        </div>
        {{#if editable}}
          <div class="hf-hp-controls">
            <button type="button" data-action="hp-adjust" data-delta="-1" title="-1"><i class="fas fa-minus"></i></button>
            <input type="text" class="hf-hp-input" data-change="hp-input"
                   placeholder="±" title="{{localize 'HOPEFINDER.Header.HpInputHint'}}">
            <button type="button" data-action="hp-adjust" data-delta="1" title="+1"><i class="fas fa-plus"></i></button>
            <input type="number" class="hf-temp-input" name="system.attributes.hp.temp"
                   value="{{combat.hp.temp}}" min="0" title="{{localize 'HOPEFINDER.Header.TempHp'}}">
          </div>
        {{/if}}
      </div>

      <div class="hf-status-block" title="{{localize 'HOPEFINDER.Combat.AC'}}">
        <i class="fas fa-shield-halved"></i>
        <span class="hf-status-value">{{combat.ac}}</span>
        <label>{{localize 'HOPEFINDER.Combat.AC'}}</label>
      </div>

      <div class="hf-status-block hf-clickable" data-action="roll-perception"
           title="{{localize 'HOPEFINDER.Combat.RollPerception'}}">
        <i class="fas fa-eye"></i>
        <span class="hf-status-value">{{combat.perception.modStr}}</span>
        <label>{{localize 'HOPEFINDER.Combat.Perception'}}</label>
      </div>

      <div class="hf-status-block" title="{{localize 'HOPEFINDER.Combat.Speed'}}">
        <i class="fas fa-person-running"></i>
        <span class="hf-status-value">{{combat.speed.land}}</span>
        <label>{{localize 'HOPEFINDER.Combat.Speed'}}</label>
      </div>

      <div class="hf-statusbar-conditions">
        {{#each conditions}}
          <span class="hf-cond-chip" data-action="condition-badge" data-slug="{{this.slug}}"
                title="{{this.name}} — {{localize 'HOPEFINDER.Conditions.BadgeHint'}}">
            <img src="{{this.img}}" alt="{{this.name}}">
            {{#if this.value}}<b>{{this.value}}</b>{{/if}}
          </span>
        {{/each}}
        {{#if editable}}
          <details class="hf-cond-menu">
            <summary title="{{localize 'HOPEFINDER.Conditions.Add'}}"><i class="fas fa-plus"></i></summary>
            <div class="hf-cond-list">
              {{#each quickConditions}}
                <button type="button" data-action="condition-add" data-slug="{{this.slug}}"
                        data-name="{{this.name}}">{{this.name}}</button>
              {{/each}}
            </div>
          </details>
        {{/if}}
      </div>
    </header>

    <section class="hf-tabs">

      {{!-- ── PROFILE ── --}}
      <div class="hf-tab active" data-tab="profile">
        <div class="hf-npc-grid">

          <section class="hf-panel hf-attributes">
            <h2 class="hf-panel-title"><i class="fas fa-dna"></i>{{localize 'HOPEFINDER.Survivor.Attributes'}}</h2>
            <div class="hf-ability-row">
              {{#each abilities}}
                <button type="button" class="hf-ability" data-action="roll-ability" data-ability="{{this.key}}"
                        title="{{localize 'HOPEFINDER.Survivor.RollAbility'}}">
                  <span class="hf-ability-key">{{this.label}}</span>
                  <span class="hf-ability-mod">{{this.modStr}}</span>
                </button>
              {{/each}}
            </div>
            <div class="hf-saves-row">
              {{#each combat.saves}}
                <button type="button" class="hf-save hf-rank--{{this.rank}}" data-action="roll-save" data-save="{{this.key}}">
                  <span class="hf-save-label">{{this.label}}</span>
                  <span class="hf-save-mod">{{this.modStr}}</span>
                  <span class="hf-save-rank">{{this.rankLabel}}</span>
                </button>
              {{/each}}
            </div>
          </section>

          <section class="hf-panel hf-sitrep">
            <h2 class="hf-panel-title"><i class="fas fa-satellite-dish"></i>{{localize 'HOPEFINDER.Survivor.Sitrep'}}</h2>
            <div class="hf-sitrep-grid">
              {{#if combat.senses.length}}
                <div class="hf-sitrep-row">
                  <label>{{localize 'HOPEFINDER.Survivor.Senses'}}</label>
                  <div class="hf-chip-row">{{#each combat.senses}}<span class="hf-chip">{{this}}</span>{{/each}}</div>
                </div>
              {{/if}}
              {{#if combat.languages.length}}
                <div class="hf-sitrep-row">
                  <label>{{localize 'HOPEFINDER.Survivor.Languages'}}</label>
                  <div class="hf-chip-row">{{#each combat.languages}}<span class="hf-chip">{{this}}</span>{{/each}}</div>
                </div>
              {{/if}}
              {{#if combat.resistances.length}}
                <div class="hf-sitrep-row">
                  <label>{{localize 'HOPEFINDER.Survivor.Resistances'}}</label>
                  <div class="hf-chip-row">{{#each combat.resistances}}<span class="hf-chip hf-chip--good">{{this}}</span>{{/each}}</div>
                </div>
              {{/if}}
              {{#if combat.immunities.length}}
                <div class="hf-sitrep-row">
                  <label>{{localize 'HOPEFINDER.Survivor.Immunities'}}</label>
                  <div class="hf-chip-row">{{#each combat.immunities}}<span class="hf-chip hf-chip--good">{{this}}</span>{{/each}}</div>
                </div>
              {{/if}}
              {{#if combat.weaknesses.length}}
                <div class="hf-sitrep-row">
                  <label>{{localize 'HOPEFINDER.Survivor.Weaknesses'}}</label>
                  <div class="hf-chip-row">{{#each combat.weaknesses}}<span class="hf-chip hf-chip--bad">{{this}}</span>{{/each}}</div>
                </div>
              {{/if}}
              {{#if combat.speed.others.length}}
                <div class="hf-sitrep-row">
                  <label>{{localize 'HOPEFINDER.Combat.OtherSpeeds'}}</label>
                  <div class="hf-chip-row">{{#each combat.speed.others}}<span class="hf-chip">{{this.label}} {{this.value}}</span>{{/each}}</div>
                </div>
              {{/if}}
            </div>

            {{#if effects.length}}
              <div class="hf-effects">
                <label>{{localize 'HOPEFINDER.Survivor.ActiveEffects'}}</label>
                <div class="hf-effect-row">
                  {{#each effects}}
                    <span class="hf-effect" data-item-id="{{this.id}}" data-hf-tip="{{this.id}}">
                      <img src="{{this.img}}" alt="" data-action="effect-open">
                      {{#if this.badge}}<b>{{this.badge}}</b>{{/if}}
                      <button type="button" class="hf-effect-x" data-action="effect-remove" title="{{localize 'HOPEFINDER.Common.Remove'}}">
                        <i class="fas fa-xmark"></i>
                      </button>
                    </span>
                  {{/each}}
                </div>
              </div>
            {{/if}}
          </section>

          <section class="hf-panel hf-npc-skills">
            <h2 class="hf-panel-title"><i class="fas fa-diagram-project"></i>{{localize 'HOPEFINDER.Tabs.skills'}}</h2>
            <div class="hf-skills-grid">
              {{#each skills}}
                <button type="button" class="hf-skill-card hf-rank--{{this.rank}} {{#if this.lore}}hf-skill--lore{{/if}}"
                        data-action="roll-skill" data-skill="{{this.key}}"
                        title="{{localize 'HOPEFINDER.Skills.RollHint'}}">
                  <div class="hf-skill-top">
                    <span class="hf-skill-name">{{this.label}}</span>
                    <span class="hf-skill-attr">{{this.attribute}}</span>
                  </div>
                  <div class="hf-skill-mod">{{this.modStr}}</div>
                  {{#if this.lore}}<span class="hf-skill-lorebadge">{{localize 'HOPEFINDER.Skills.Lore'}}</span>{{/if}}
                </button>
              {{/each}}
            </div>
          </section>
        </div>
      </div>

      {{!-- ── ARSENAL ── --}}
      <div class="hf-tab" data-tab="arsenal">
        {{#if strikes.length}}
          <div class="hf-quickstrike-list">
            {{#each strikes}}
              <div class="hf-quickstrike" {{#if this.itemId}}data-item-id="{{this.itemId}}" data-hf-tip="{{this.itemId}}"{{/if}}>
                <img src="{{this.img}}" alt="">
                <div class="hf-quickstrike-info">
                  <span class="hf-quickstrike-name">{{this.label}}</span>
                  {{#if this.damagePreview}}<span class="hf-quickstrike-dmg">{{this.damagePreview}}</span>{{/if}}
                  {{#if this.traits.length}}
                    <span class="hf-chip-row">{{#each this.traits}}<span class="hf-chip">{{this}}</span>{{/each}}</span>
                  {{/if}}
                </div>
                <div class="hf-quickstrike-buttons">
                  {{#each this.variants}}
                    <button type="button" class="hf-btn hf-btn--attack" data-action="strike-attack"
                            data-idx="{{../idx}}" data-variant="{{this.idx}}">{{this.label}}</button>
                  {{/each}}
                  <button type="button" class="hf-btn hf-btn--damage" data-action="strike-damage" data-idx="{{this.idx}}"
                          title="{{localize 'HOPEFINDER.Arsenal.Damage'}}"><i class="fas fa-burst"></i></button>
                  <button type="button" class="hf-btn hf-btn--crit" data-action="strike-critical" data-idx="{{this.idx}}"
                          title="{{localize 'HOPEFINDER.Arsenal.Critical'}}"><i class="fas fa-skull"></i></button>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="hf-empty">{{localize 'HOPEFINDER.Survivor.NoStrikes'}}</p>
        {{/if}}
      </div>

      {{!-- ── LOOT ── --}}
      <div class="hf-tab" data-tab="loot">
        <section class="hf-gear-main">
          <div class="hf-gear-toolbar">
            <div class="hf-search">
              <i class="fas fa-magnifying-glass"></i>
              <input type="search" data-action="gear-search" data-noclick="true"
                     placeholder="{{localize 'HOPEFINDER.Gear.Search'}}" value="{{gear.search}}">
            </div>
            <div class="hf-filter-row">
              {{#each gear.filters}}
                <button type="button" class="hf-filter-chip {{#if this.active}}active{{/if}}"
                        data-action="gear-filter" data-filter="{{this.id}}">{{this.label}}</button>
              {{/each}}
            </div>
          </div>

          <div class="hf-gear-grid">
            {{#each gear.items}}
              <div class="hf-card hf-card--{{this.rarity}} {{#if this.equipped}}equipped{{/if}}"
                   data-item-id="{{this.id}}" data-hf-tip="{{this.id}}" draggable="true"
                   data-filter-type="{{this.filterType}}" data-fav="{{this.favorite}}" data-search="{{this.searchKey}}">
                <div class="hf-card-visual">
                  <img src="{{this.img}}" alt="" loading="lazy">
                  {{#if this.equipped}}<span class="hf-card-flag"><i class="fas fa-check"></i></span>{{/if}}
                  {{#if this.quantity}}{{#if (hfGt this.quantity 1)}}<span class="hf-card-qty">×{{this.quantity}}</span>{{/if}}{{/if}}
                </div>
                <div class="hf-card-body">
                  <span class="hf-card-name">{{this.name}}</span>
                  <span class="hf-card-meta">{{this.typeLabel}} · <i class="fas fa-weight-hanging"></i> {{this.bulk}}</span>
                </div>
                {{#if ../editable}}
                  <div class="hf-card-actions">
                    {{#if this.canEquip}}
                      <button type="button" data-action="item-equip" title="{{localize 'HOPEFINDER.Gear.Equip'}}"><i class="fas fa-vest"></i></button>
                    {{/if}}
                    {{#if this.stackable}}
                      <button type="button" data-action="item-qty" data-delta="-1" title="-1"><i class="fas fa-minus"></i></button>
                      <button type="button" data-action="item-qty" data-delta="1" title="+1"><i class="fas fa-plus"></i></button>
                    {{/if}}
                    <button type="button" data-action="item-chat" title="{{localize 'HOPEFINDER.Gear.ToChat'}}"><i class="fas fa-comment"></i></button>
                    <button type="button" data-action="item-open" title="{{localize 'HOPEFINDER.Common.Edit'}}"><i class="fas fa-pen"></i></button>
                    <button type="button" class="hf-danger" data-action="item-delete" title="{{localize 'HOPEFINDER.Common.Delete'}}"><i class="fas fa-trash"></i></button>
                  </div>
                {{/if}}
              </div>
            {{/each}}
          </div>

          <div class="hf-gear-empty hf-empty {{#if gear.items.length}}hf-hidden{{/if}}">
            <i class="fas fa-box-open"></i>
            <p>{{localize 'HOPEFINDER.Npc.LootEmpty'}}</p>
          </div>
        </section>
      </div>

      {{!-- ── NOTES ── --}}
      <div class="hf-tab" data-tab="notes">
        <div class="hf-npc-notes">
          <section class="hf-panel">
            <h2 class="hf-panel-title"><i class="fas fa-eye"></i>{{localize 'HOPEFINDER.Npc.PublicNotes'}}</h2>
            {{#if editable}}
              <textarea class="hf-notes-editor" name="system.details.publicNotes"
                        placeholder="{{localize 'HOPEFINDER.Npc.NotesPlaceholder'}}">{{notes.publicRaw}}</textarea>
            {{else}}
              <div class="hf-paper">{{{notes.publicNotes}}}</div>
            {{/if}}
          </section>
          {{#if owner}}
            <section class="hf-panel">
              <h2 class="hf-panel-title"><i class="fas fa-eye-slash"></i>{{localize 'HOPEFINDER.Npc.PrivateNotes'}}</h2>
              {{#if editable}}
                <textarea class="hf-notes-editor" name="system.details.privateNotes"
                          placeholder="{{localize 'HOPEFINDER.Npc.NotesPlaceholder'}}">{{notes.privateRaw}}</textarea>
              {{else}}
                <div class="hf-paper">{{{notes.privateNotes}}}</div>
              {{/if}}
            </section>
          {{/if}}
        </div>
      </div>
    </section>
  </main>
</form>
